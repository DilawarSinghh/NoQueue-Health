# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or expose these keys to the client.

# --- AI (Groq) — server-only ---
# https://console.groq.com/keys
GROQ_API_KEY=

# --- Email (Resend) — server-only ---
# https://resend.com/api-keys
RESEND_API_KEY=

# --- Supabase ---
# Public values (safe to expose to the browser, used by client-side client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — SERVER ONLY. Bypasses RLS. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Clinic ---
# Email address where completed intake PDFs are sent for this test clinic
HOSPITAL_NOTIFY_EMAIL=
