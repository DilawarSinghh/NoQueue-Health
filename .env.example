# Copy this file to .env.local (or .env) and fill in real values.
# NEVER commit .env / .env.local or expose these keys to the client.

# --- AI Providers - server-only ---
# At least one provider key must be set. The system tries them in order:
# MiniMax → Gemini → Groq (with automatic fallback on failure).

# MiniMax M3 (via xkiro.com — OpenAI-compatible)
# Get key from: https://xkiro.com or your MiniMax provider
XKIRO_API_KEY=
XKIRO_BASE_URL=https://api.xkiro.com/v1
MINIMAX_MODEL=minimax/minimax-m3:free

# Google Gemini
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (fallback — reliable, English-optimized)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=

# --- Email (Resend) - server-only ---
# https://resend.com/api-keys
RESEND_API_KEY=
# Optional: "Name <email@your-domain.com>" verified sender. Defaults to
# "Scriba <onboarding@resend.dev>" (Resend test sender - until you verify a
# domain, Resend only delivers to your own account email).
RESEND_FROM_EMAIL=

# --- Supabase ---
# Public values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - SERVER ONLY. Bypasses RLS. Never import in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Clinic report destination ---
# Fixed destination for AI-generated patient reports (server-side only, never
# chosen by the patient). Also used as HOSPITAL_NOTIFY_EMAIL in some env setups.
DOCTOR_REPORT_EMAIL=

# --- Google OAuth ---
# NOT set in this file. Google OAuth is configured in the Supabase dashboard
# (Authentication > Providers > Google). Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials and paste the
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET into Supabase - they live there,
# not in your app environment.

# --- Site URL (used for OAuth redirect) ---
# Local dev: http://localhost:3000
# Production: your Vercel deployment URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://noqueuhealth.vercel.app

